PORT=3000
NODE_ENV=development
CLIENT_ORIGINS=*
ROOM_TTL_HOURS=12
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_tu_clave_secreta
USE_MEMORY_REPOSITORY=false

# OCR visual por API. DeepSeek acepta la imagen en base64 y no requiere IA local.
# Crea una API key en https://platform.deepseek.com/
OCR_API_URL=https://api.deepseek.com/chat/completions
OCR_API_KEY=pega_aqui_tu_api_key
OCR_MODEL=deepseek-flash
OCR_MAX_IMAGE_MB=8
